---
import NavigationTopBar, { type NavigationVariant, type NavigationTextColor } from '@components/NavigationTopBar.astro';
import Footer from '@components/Footer.astro';
import PreviewBanner from '@components/PreviewBanner.astro';
import { getSettings } from '../lib/sanity';
import type { SanityMeta, SanityPreviewLabel } from '../lib/sanity';
import '@styles/global.css';
import fontRegular from '../assets/fonts/DavidLibre-Regular.ttf';
import fontMedium from '../assets/fonts/DavidLibre-Medium.ttf';
import fontBold from '../assets/fonts/DavidLibre-Bold.ttf';

interface Props {
  bodyClass?: string;
  backgroundColor?: 'sand-050' | 'white' | 'sand-100' | 'forest-400';
  canonicalUrl?: string;
  description?: string; // plain-string fallback for non-CMS pages
  mainClass?: string;
  meta?: SanityMeta; // Sanity-backed meta for CMS pages
  navigationVariant?: NavigationVariant;
  previewLabel?: SanityPreviewLabel;
  textColor?: NavigationTextColor;
  title: string;
}

const {
  title,
  description,
  meta: pageMeta,
  backgroundColor = 'white',
  textColor = 'ink-900',
  mainClass = '',
  navigationVariant = 'transparent',
  bodyClass = '',
  canonicalUrl: canonicalOverride,
  previewLabel,
} = Astro.props;

const settings = await getSettings();
const siteMeta = settings?.meta;

const resolvedTitle = pageMeta?.ogTitle ?? title;
const resolvedDescription = pageMeta?.ogDescription ?? description ?? siteMeta?.ogDescription;
const resolvedOgImage = pageMeta?.ogImage?.url ?? siteMeta?.ogImage?.url;
const siteUrl = Astro.site ?? new URL('https://www.bristolsuites.com');
const canonicalUrl = new URL(canonicalOverride ?? Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/ttf" href={fontRegular} crossorigin />
    <link rel="preload" as="font" type="font/ttf" href={fontMedium} crossorigin />
    <link rel="preload" as="font" type="font/ttf" href={fontBold} crossorigin />

    <title>{resolvedTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}

    <!-- Open Graph -->
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    {resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <slot name="head" />
  </head>
  <body class:list={['flex flex-col min-h-screen font-serif', `bg-${backgroundColor}`, `text-${textColor}`, bodyClass]}>
    <div class="flex flex-col flex-1">
      {previewLabel && <PreviewBanner label={previewLabel} />}
      <NavigationTopBar variant={navigationVariant} />
      <main id="main-content" tabindex="-1" class:list={['MainContent', mainClass]}>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
