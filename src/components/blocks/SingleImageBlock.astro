---
import ImageComponent from '@components/ui/ImageComponent.astro';
import TextStyle from '@components/ui/TextStyle.astro';
import { buildSanityImageUrl } from '../../lib/sanity';
import { INNER_MAX_WIDTH__DESKTOP, IMAGE_SIZES, ASPECT_RATIOS, type ImageLayout } from '@components/ui/constants';
import { getSpacerClasses, type SpacerSize } from './layoutOptions';

interface Props {
  image?: { url?: string; alt?: string; caption?: string; layout?: ImageLayout; rounded?: boolean };
  layout?: ImageLayout;
  caption?: string;
  rounded?: boolean;
  textColor?: string;
  backgroundColor?: string;
  topSpacer?: SpacerSize;
  bottomSpacer?: SpacerSize;
  maxImageWidth?: number;
  sizes?: string;
}

const {
  image,
  layout: layoutProp = 'default',
  caption: captionProp,
  rounded: roundedProp,
  textColor,
  backgroundColor,
  topSpacer,
  bottomSpacer,
  maxImageWidth,
  sizes: sizesProp,
} = Astro.props;
const layout = image?.layout ?? layoutProp;
const caption = image?.caption ?? captionProp;
const rounded = image?.rounded ?? roundedProp ?? true;
const url = image?.url;
const constrainedImageWidth = 520;
const constrainedSourceWidth = constrainedImageWidth * 2;
const isConstrainedLayout = layout === 'narrow' || layout === 'portrait';
const defaultImageWidth = layout === 'fullbleed' ? INNER_MAX_WIDTH__DESKTOP : isConstrainedLayout ? constrainedSourceWidth : IMAGE_SIZES[2].width;
const imgWidth = Math.round(maxImageWidth ?? defaultImageWidth);
// eslint-disable-next-line security/detect-object-injection
const imgHeight = Math.round(imgWidth / ASPECT_RATIOS[layout]);
const smallImageWidth = Math.round(imgWidth / 2);
const smallImageHeight = Math.round(imgHeight / 2);

const wrapperStyle = [textColor ? `color: ${textColor}` : '', backgroundColor ? `background-color: ${backgroundColor}` : ''].filter(Boolean).join('; ');

const figureLayoutClasses: Partial<Record<ImageLayout, string>> = {
  narrow: 'max-w-[min(100%,520px)] mx-auto',
  portrait: 'max-w-[min(100%,520px)] mx-auto',
};
const frameLayoutClasses: Record<ImageLayout, string> = {
  fullbleed: 'aspect-[5/3]',
  default: 'aspect-[5/3]',
  square: 'aspect-square',
  narrow: 'aspect-[5/3]',
  portrait: 'aspect-[3/4]',
};
// eslint-disable-next-line security/detect-object-injection
const figureLayoutClass = figureLayoutClasses[layout];
// eslint-disable-next-line security/detect-object-injection
const frameLayoutClass = frameLayoutClasses[layout];
const figureClass = [figureLayoutClass, layout].filter(Boolean).join(' ');
const frameClass = [frameLayoutClass, 'overflow-hidden', rounded && 'rounded-xl'].filter(Boolean).join(' ');
const imageClass = 'h-full w-full object-cover';
const imageSizes = sizesProp ?? (layout === 'fullbleed' ? '100vw' : isConstrainedLayout ? '(min-width: 520px) 520px, 100vw' : '(min-width: 1240px) 60vw, 100vw');
const spacerClasses = topSpacer || bottomSpacer ? getSpacerClasses(topSpacer, bottomSpacer) : undefined;
---

{
  url && (
    <figure class:list={[figureClass, spacerClasses]} style={wrapperStyle || undefined}>
      <div class={frameClass}>
        <ImageComponent
          src={buildSanityImageUrl(url, { width: imgWidth, height: imgHeight, fit: 'crop' })}
          srcset={`${buildSanityImageUrl(url, { width: smallImageWidth, height: smallImageHeight, fit: 'crop' })} ${smallImageWidth}w, ${buildSanityImageUrl(url, { width: imgWidth, height: imgHeight, fit: 'crop' })} ${imgWidth}w`}
          sizes={imageSizes}
          alt={(image?.alt ?? '') as string}
          width={imgWidth}
          height={imgHeight}
          loading="lazy"
          fadeIn
          class={imageClass}
          imgClass={imageClass}
        />
      </div>
      {caption && (
        <figcaption class="mt-2">
          <TextStyle variant="caption">{caption}</TextStyle>
        </figcaption>
      )}
    </figure>
  )
}
