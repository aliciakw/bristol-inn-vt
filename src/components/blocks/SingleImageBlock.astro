---
import ImageComponent from '@components/ui/ImageComponent.astro';
import TextStyle from '@components/ui/TextStyle.astro';
import { buildSanityImageUrl } from '../../lib/sanity';
import { INNER_MAX_WIDTH__DESKTOP, IMAGE_SIZES, ASPECT_RATIOS, type ImageLayout } from '@components/ui/constants';

interface Props {
  image?: { url?: string; alt?: string; caption?: string; layout?: ImageLayout; rounded?: boolean };
  layout?: ImageLayout;
  caption?: string;
  rounded?: boolean;
  textColor?: string;
  backgroundColor?: string;
}

const { image, layout: layoutProp = 'default', caption: captionProp, rounded: roundedProp, textColor, backgroundColor } = Astro.props;
const layout = image?.layout ?? layoutProp;
const caption = image?.caption ?? captionProp;
const rounded = image?.rounded ?? roundedProp ?? true;
const url = image?.url;
const imgWidth = layout === 'fullbleed' ? INNER_MAX_WIDTH__DESKTOP : layout === 'narrow' ? IMAGE_SIZES[3].width : IMAGE_SIZES[2].width;
// eslint-disable-next-line security/detect-object-injection
const imgHeight = imgWidth / ASPECT_RATIOS[layout];

const wrapperStyle = [textColor ? `color: ${textColor}` : '', backgroundColor ? `background-color: ${backgroundColor}` : ''].filter(Boolean).join('; ');

const figureLayoutClasses: Partial<Record<ImageLayout, string>> = {
  narrow: 'max-w-[min(100%,520px)] mx-auto',
};
const frameLayoutClasses: Record<ImageLayout, string> = {
  fullbleed: 'aspect-[5/3]',
  default: 'aspect-[5/3]',
  square: 'aspect-square',
  narrow: 'aspect-[5/3]',
};
// eslint-disable-next-line security/detect-object-injection
const figureLayoutClass = figureLayoutClasses[layout];
// eslint-disable-next-line security/detect-object-injection
const frameLayoutClass = frameLayoutClasses[layout];
const figureClass = [figureLayoutClass, layout].filter(Boolean).join(' ');
const frameClass = [frameLayoutClass, 'overflow-hidden', rounded && 'rounded-xl'].filter(Boolean).join(' ');
const imageClass = 'h-full w-full object-cover';
const imageSizes = layout === 'fullbleed' ? '100vw' : '(min-width: 1240px) 60vw, 100vw';
---

{
  url && (
    <figure class={figureClass} style={wrapperStyle || undefined}>
      <div class={frameClass}>
        <ImageComponent
          src={buildSanityImageUrl(url, { width: imgWidth, height: imgHeight })}
          srcset={`${buildSanityImageUrl(url, { width: imgWidth / 2, height: imgHeight / 2 })} ${imgWidth / 2}w, ${buildSanityImageUrl(url, { width: imgWidth, height: imgHeight })} ${imgWidth}w`}
          sizes={imageSizes}
          alt={(image?.alt ?? '') as string}
          width={imgWidth}
          height={imgHeight}
          loading="lazy"
          fadeIn
          class={imageClass}
          imgClass={imageClass}
        />
      </div>
      {caption && (
        <figcaption class="mt-2">
          <TextStyle variant="caption">{caption}</TextStyle>
        </figcaption>
      )}
    </figure>
  )
}
