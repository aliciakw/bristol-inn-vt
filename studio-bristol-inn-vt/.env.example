# Sanity Studio build-time variables
#
# Copy this file to studio-bristol-inn-vt/.env for local sanity dev/build/deploy.
# If CI deploys the Studio, configure these variables in CI instead.
#
# These values are baked into the static Studio JavaScript bundle. They are not
# runtime secrets, and the deployed Studio cannot read this file after deploy.

SANITY_STUDIO_DEPLOY_API_URL=https://bristol-inn-vt.alicia-willett.workers.dev/api/deploy

# This must match DEPLOY_TRIGGER_TOKEN on the Astro/Cloudflare site.
# It is bundled into browser JavaScript, so treat it as a light guard only.
SANITY_STUDIO_DEPLOY_TRIGGER_TOKEN=same_value_as_DEPLOY_TRIGGER_TOKEN
