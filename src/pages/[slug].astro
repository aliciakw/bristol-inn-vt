---
import { getPages, getPage } from '../lib/sanity';
import BaseLayout from '@layouts/BaseLayout.astro';
import GenericPageContent from '@components/pages/GenericPageContent.astro';

export async function getStaticPaths() {
  // Slugs handled by dedicated page files — exclude them from this catch-all
  const dedicatedSlugs = new Set(['rooms-and-suites']);
  const pages = await getPages();
  return pages
    .filter((page) => !dedicatedSlugs.has(page.uid))
    .map((page) => ({
      params: { slug: page.uid },
      props: { slug: page.uid },
    }));
}

type Props = { slug: string };
const { slug } = Astro.props;
const page = await getPage(slug);
const pageTitle = page.title || 'Untitled';
---

<BaseLayout
  title={`${pageTitle} — Bristol Inn`}
  meta={page?.meta}
  backgroundColor="white"
  navigationVariant="transparent"
  mainClass={page.pageHeader ? 'Spacer--navigation-offset pb-(--nav-top-bar-height) tablet:pb-16' : ''}
>
  <GenericPageContent page={page} />
</BaseLayout>
