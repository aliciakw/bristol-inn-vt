# ─────────────────────────────────────────────────────────────────────────────
# Bristol Inn — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in all values.
# .env.local is git-ignored and must NEVER be committed to the repository.
#
# For the deployed Cloudflare Worker: configure these in the Cloudflare
# Worker dashboard → Settings → Variables and Secrets.
#
# These variables are for the Astro site and /api/deploy route.
# Sanity Studio has its own build-time variables; see the bottom of this file.
# ─────────────────────────────────────────────────────────────────────────────

# Hostaway API Bearer token (Cloudflare: Secret)
# Pre-generated long-lived token from the Hostaway dashboard.
# Used as: Authorization: Bearer <token> on all /v1/listings API calls.
HOSTAWAY_ACCESS_TOKEN=your_hostaway_access_token_here

# Sanity CMS read token (Cloudflare: Secret)
# Generate at: https://sanity.io/manage → project 4rk27ty6 → API → Tokens
SANITY_API_TOKEN=your_sanity_api_token_here

# Shared secret required for /preview routes. (Cloudflare: Secret)
# Use the same value in SANITY_STUDIO_PREVIEW_SECRET below.
PREVIEW_SECRET=shared_preview_secret

# Sentry authentication token (Cloudflare: Secret; optional)
# Used only at build time to upload source maps to Sentry.
# Generate at: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Sentry DSN (Cloudflare: Plain text; PUBLIC — visible in client JS; optional)
# Found in: Sentry project → Settings → Client Keys (DSN)
PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/0

# Google Analytics 4 Measurement ID (Cloudflare: Plain text; PUBLIC — visible in client JS; optional)
# Format: G-XXXXXXXXXX — found in GA4 dashboard → Admin → Data Streams
PUBLIC_GA4_ID=G-XXXXXXXXXX

# GitHub Actions deploy button. These belong on the Astro/Worker site because
# /api/deploy runs there, not inside Sanity Studio.

# GitHub token with repository Actions read/write access. (Cloudflare: Secret)
GITHUB_DEPLOY_TOKEN=your_github_actions_dispatch_token_here

# Repository and workflow to dispatch. (Cloudflare: Plain text)
GITHUB_DEPLOY_OWNER=aliciakw
GITHUB_DEPLOY_REPO=bristol-inn-vt
GITHUB_DEPLOY_WORKFLOW_ID=deploy-site.yml
GITHUB_DEPLOY_REF=main

# Comma-separated browser origins allowed to call /api/deploy. (Cloudflare: Plain text)
# Use exact origins only: scheme + host + optional port. No paths or trailing slashes.
# Add http://127.0.0.1:3333 too if you use that instead of localhost.
DEPLOY_ALLOWED_ORIGINS=http://localhost:3333,https://bristol-inn-vt.sanity.studio,https://www.sanity.io

# Bearer token required for POST /api/deploy. (Cloudflare: Secret)
# Do not treat the matching SANITY_STUDIO_DEPLOY_TRIGGER_TOKEN as a true secret:
# Sanity Studio env vars are bundled into client-side JavaScript.
DEPLOY_TRIGGER_TOKEN=shared_deploy_trigger_token

# ─────────────────────────────────────────────────────────────────────────────
# Sanity Studio deploy button variables
# ─────────────────────────────────────────────────────────────────────────────
# Put these in studio-bristol-inn-vt/.env for local sanity dev/build/deploy.
# If CI deploys the Studio, configure these in CI instead.
# They are baked into the static Studio bundle at build/deploy time.

SANITY_STUDIO_DEPLOY_API_URL=https://bristol-inn-vt.alicia-willett.workers.dev/api/deploy
SANITY_STUDIO_DEPLOY_TRIGGER_TOKEN=same_value_as_DEPLOY_TRIGGER_TOKEN
SANITY_STUDIO_SITE_URL=https://bristol-inn-vt.alicia-willett.workers.dev
SANITY_STUDIO_PREVIEW_SECRET=same_value_as_PREVIEW_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Actions deploy-site.yml variables
# ─────────────────────────────────────────────────────────────────────────────
# Configure these in GitHub repository Settings → Secrets and variables → Actions.
# The deploy button dispatches that workflow; the workflow uses these values to
# build the static site and publish it with Wrangler.
#
# GitHub Actions secrets:
#   HOSTAWAY_ACCESS_TOKEN
#   SANITY_API_TOKEN
#   PREVIEW_SECRET
#   CLOUDFLARE_ACCOUNT_ID
#   CLOUDFLARE_API_TOKEN
#   SENTRY_AUTH_TOKEN (optional)
#
# GitHub Actions variables:
#   PUBLIC_SENTRY_DSN (optional)
#   PUBLIC_GA4_ID (optional)
