---
import BaseLayout from '@layouts/BaseLayout.astro';
import { RoomBrowser } from '../components/rooms/RoomBrowser';
import { getPage } from '../lib/sanity';
import { getRooms } from '../lib/rooms';
import GenericPageContent from '@components/pages/GenericPageContent.astro';

const [page, rooms] = await Promise.all([getPage('rooms-and-suites'), getRooms()]);

const pageTitle = page?.title || 'Rooms & Suites';

const browserRooms = rooms.map((r) => ({
  id: r.id,
  name: r.name,
  bedroomsLabel: r.bedroomsLabel,
  price: r.price,
  personCapacity: r.personCapacity,
  floorNumber: r.floorNumber,
  dogsAllowed: r.dogsAllowed,
  photo: r.photos[0] ?? { url: '', caption: '' },
  amenities: r.amenityNames.slice(0, 3),
}));
---

<BaseLayout
  title={`${pageTitle} — Bristol Inn`}
  meta={page?.meta}
  backgroundColor="white"
  navigationVariant="transparent"
  mainClass="Spacer--navigation-offset Spacer--page-bottom"
>
  <GenericPageContent page={page} pageHeaderClass="pb-8" />

  <section class="Section mt-[-72px] mb-16">
    <div class="Grid">
      <div class="col-span-6 tablet:col-span-8 desktop:col-span-10 desktop:col-start-2">
        <RoomBrowser client:load rooms={browserRooms} />
      </div>
    </div>
  </section>
</BaseLayout>
